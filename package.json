{
  "name": "hangin-kite-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "python3 -m http.server 4173 -d out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test && npm run audit:privacy",
    "audit:privacy": "node scripts/privacy-audit.mjs",
    "audit:privacy:deployed": "node scripts/audit-deployed-privacy.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "acorn": "8.18.0",
    "css-tree": "3.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "parse5": "8.0.1",
    "saxes": "6.0.0",
    "srcset": "5.0.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
